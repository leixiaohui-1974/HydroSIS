# HydroMind Agent 环境变量配置示例
# 复制此文件为 .env 并填写实际值

# ========== LLM配置 ==========
# 阿里千问API密钥（必需）
QWEN_API_KEY=sk-your-api-key-here

# 模型选择（可选）
QWEN_MODEL=qwen-max
# 可选值:
#   - qwen-max: 最强性能，最贵
#   - qwen-plus: 平衡性能和成本
#   - qwen-turbo: 快速响应，便宜

# LLM后端类型（可选）
LLM_BACKEND=auto
# 可选值:
#   - auto: 自动选择（有API key用qwen，否则mock）
#   - qwen: 强制使用千问
#   - mock: 强制使用Mock（测试用）

# ========== 服务器配置 ==========
# 监听地址
HOST=0.0.0.0

# 监听端口
PORT=8081

# 日志级别
LOG_LEVEL=INFO

# ========== 其他配置 ==========
# 知识库路径（可选）
KNOWLEDGE_BASE_DIR=./knowledge_base

# 模板路径（可选）
TEMPLATE_DIR=./prompt_templates
